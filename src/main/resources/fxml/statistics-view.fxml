<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.echoes.echoes.controller.StatisticsController"
            styleClass="root">

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background:#0A0A18;">

            <content>

                <VBox spacing="30"
                      styleClass="content">

                    <padding>
                        <Insets top="35"
                                right="35"
                                bottom="35"
                                left="35"/>
                    </padding>

                    <!-- ================= TITLE ================= -->

                    <Label text="📊 Statistics"
                           styleClass="heading"/>

                    <!-- ================= STATISTICS CARDS ================= -->

                    <FlowPane fx:id="statsPane"
                              hgap="20"
                              vgap="20"
                              prefWrapLength="900">

                        <!-- Total Memories -->

                        <VBox spacing="10"
                              styleClass="stat-card">

                            <Label text="Total Memories"
                                   styleClass="stat-title"/>

                            <Label fx:id="totalMemoriesLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                        <!-- Favorite Memories -->

                        <VBox spacing="10"
                              styleClass="stat-card">

                            <Label text="Favorite Memories"
                                   styleClass="stat-title"/>

                            <Label fx:id="favoriteMemoriesLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                        <!-- Most Common Emotion -->

                        <VBox spacing="10"
                              alignment="CENTER"
                              styleClass="stat-card">

                            <Label text="Most Common Emotion"
                                   styleClass="stat-title"/>

                            <VBox spacing="2"
                                  alignment="CENTER">

                                <Label fx:id="topEmotionEmojiLabel"
                                       text="😊"
                                       styleClass="emotion-card-emoji"/>

                                <Label fx:id="topEmotionLabel"
                                       text="-"
                                       styleClass="emotion-card-name"/>

                            </VBox>

                        </VBox>

                        <!-- Favorite Artist -->

                        <VBox spacing="10"
                              styleClass="stat-card">

                            <Label text="Favorite Artist"
                                   styleClass="stat-title"/>

                            <Label fx:id="topArtistLabel"
                                   text="-"
                                   styleClass="stat-value"/>

                        </VBox>

                        <!-- Memories This Month -->

                        <VBox spacing="10"
                              styleClass="stat-card">

                            <Label text="Memories This Month"
                                   styleClass="stat-title"/>

                            <Label fx:id="thisMonthLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                        <!-- Memories This Year -->

                        <VBox spacing="10"
                              styleClass="stat-card">

                            <Label text="Memories This Year"
                                   styleClass="stat-title"/>

                            <Label fx:id="thisYearLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                    </FlowPane>

                    <!-- ================= EMOTION CHART ================= -->

                    <VBox spacing="20">

                        <Label text="Emotion Distribution"
                               styleClass="section-title"/>

                        <VBox fx:id="emotionContainer"
                              spacing="18"/>

                    </VBox>
                    <VBox spacing="20">

                        <Label text="Memory Activity"
                               styleClass="section-title"/>
                        <Label fx:id="calendarMonthLabel"
                               styleClass="section-subtitle"/>
                        <Label text="Your memory journey this month"
                               styleClass="calendar-description"/>
                        <GridPane fx:id="calendarGrid"
                                  hgap="6"
                                  vgap="6"/>
                        <HBox spacing="18">

                            <HBox spacing="6"
                                  alignment="CENTER_LEFT">

                                <Region styleClass="calendar-legend-empty"/>

                                <Label text="No Memory"
                                       styleClass="calendar-legend-text"/>

                            </HBox>

                            <HBox spacing="6"
                                  alignment="CENTER_LEFT">

                                <Region styleClass="calendar-legend-active"/>

                                <Label text="Memory Added"
                                       styleClass="calendar-legend-text"/>

                            </HBox>

                        </HBox>

                    </VBox>

                    <!-- ================= BACK BUTTON ================= -->

                    <Button text="← Back"
                            onAction="#handleBack"
                            styleClass="begin-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>