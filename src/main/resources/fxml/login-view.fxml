<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.echoes.echoes.controller.LoginController">

    <center>

        <VBox alignment="CENTER"
              spacing="18">

            <padding>
                <Insets top="55"
                        right="50"
                        bottom="55"
                        left="50"/>
            </padding>


            <!-- ================= JOURNAL ================= -->

            <Label text="📖"
                   styleClass="welcome-icon"/>


            <!-- ================= TITLE ================= -->

            <Label text="Welcome "
                   styleClass="welcome-title"/>


            <!-- ================= DESCRIPTION ================= -->

            <Label text="Continue your journey through&#10;the memories you've preserved."
                   wrapText="true"
                   minHeight="45"
                   prefHeight="45"
                   maxWidth="500"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   styleClass="welcome-description"/>


            <Region prefHeight="6"/>


            <!-- ================= EMAIL ================= -->

            <TextField fx:id="emailField"
                       promptText="Email Address"
                       prefWidth="500"
                       maxWidth="500"
                       styleClass="modern-field"/>


            <!-- ================= PASSWORD ================= -->

            <HBox alignment="CENTER"
                  spacing="8">

                <StackPane>

                    <PasswordField fx:id="passwordField"
                                   promptText="Password"
                                   prefWidth="215"
                                   styleClass="modern-field"/>

                    <TextField fx:id="visiblePasswordField"
                               promptText="Password"
                               prefWidth="215"
                               visible="false"
                               managed="false"
                               styleClass="modern-field"/>

                </StackPane>


                <Button fx:id="togglePasswordButton"
                        text="Show"
                        onAction="#togglePassword"
                        styleClass="toggle-button"/>

            </HBox>


            <Region prefHeight="5"/>


            <!-- ================= SIGN IN ================= -->

            <Button text="Sign In"
                    onAction="#handleLogin"
                    styleClass="begin-button"/>


            <!-- ================= REGISTER ================= -->

            <Hyperlink text="Create a new account"
                       onAction="#handleRegister"
                       styleClass="modern-link"/>

        </VBox>

    </center>

</BorderPane>