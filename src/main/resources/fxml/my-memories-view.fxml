<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.echoes.echoes.controller.MyMemoriesController"
            styleClass="root">

    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <VBox spacing="25"
              styleClass="sidebar">

            <padding>
                <Insets top="30"
                        right="25"
                        bottom="30"
                        left="25"/>
            </padding>

            <!-- Logo -->

            <Label text="🎵 Echoes"
                   styleClass="sidebar-title"/>


            <!-- Navigation -->

            <Button text="🏠  Home"
                    styleClass="sidebar-button"
                    onAction="#handleHome"/>

            <Button text="🎼  My Memories"
                    styleClass="sidebar-button"/>

            <Button text="❤️  Favorites"
                    styleClass="sidebar-button"/>

            <Button text="🕒  Timeline"
                    styleClass="sidebar-button"/>

            <Button text="📊  Statistics"
                    styleClass="sidebar-button"/>

            <Button text="⚙  Settings"
                    styleClass="sidebar-button"/>


            <!-- Push footer to bottom -->

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Echoes v1.0"
                   styleClass="sidebar-footer"/>

        </VBox>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <VBox spacing="22"
              styleClass="content">

            <padding>
                <Insets top="30"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>


            <!-- =================================================
                 PAGE HEADER
                 ================================================= -->

            <HBox spacing="20"
                  alignment="CENTER_LEFT">

                <VBox spacing="5">

                    <Label text="My Memories"
                           styleClass="heading"/>

                    <Label text="Every memory has its soundtrack."
                           styleClass="subheading"/>

                </VBox>


                <!-- Push search field to right -->

                <Region HBox.hgrow="ALWAYS"/>


                <TextField fx:id="searchField"
                           promptText="Search memories..."
                           styleClass="search-field"/>

            </HBox>


            <!-- =================================================
                 MEMORY LIST
                 ================================================= -->

            <ScrollPane fx:id="memoriesScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="memory-scroll-pane">

                <content>

                    <VBox fx:id="memoriesContainer"
                          spacing="16"
                          fillWidth="true"
                          styleClass="memories-container"/>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>