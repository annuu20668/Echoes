<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.echoes.echoes.controller.FavoritesController"
            styleClass="root">


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <VBox spacing="22"
              styleClass="content">

            <padding>
                <Insets top="30"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>


            <!-- =================================================
                 BACK BUTTON
                 ================================================= -->

            <HBox alignment="CENTER_LEFT">

                <Button text="← Back"
                        onAction="#handleBack"
                        styleClass="back-button"/>

            </HBox>


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <VBox spacing="5">

                <Label text="♥ Favorite Echoes"
                       styleClass="heading"/>

                <Label text="The memories you never want to lose."
                       styleClass="subheading"/>

            </VBox>


            <!-- =================================================
                 FAVORITES
                 ================================================= -->

            <ScrollPane fx:id="favoritesScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="memory-scroll-pane">

                <content>

                    <VBox spacing="16"
                          fillWidth="true"
                          styleClass="memories-container">

                        <VBox fx:id="favoritesPane"
                              spacing="16"
                              fillWidth="true"/>

                        <!-- Empty State -->

                        <Label fx:id="emptyLabel"
                               text="♡  No favorite memories yet."
                               visible="false"
                               managed="false"
                               styleClass="empty-state"/>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>