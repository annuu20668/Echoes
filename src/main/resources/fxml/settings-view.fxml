<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.echoes.echoes.controller.SettingsController"
        styleClass="settings-root">

    <!-- =========================
         SIDEBAR
         ========================= -->

    <left>

        <VBox
                spacing="18"
                prefWidth="220"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="20"
                        bottom="30"
                        left="20"/>
            </padding>

            <Label
                    text="🎵 Echoes"
                    styleClass="sidebar-title"/>

            <Button
                    text="⌂  Home"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"
                    onAction="#handleHome"/>

            <Button
                    text="▣  My Memories"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"
                    onAction="#handleMyMemories"/>

            <Button
                    text="♥  Favorites"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"
                    onAction="#handleFavorites"/>

            <Button
                    text="◷  Timeline"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"
                    onAction="#handleTimeline"/>

            <Button
                    text="▥  Statistics"
                    maxWidth="Infinity"
                    styleClass="sidebar-button"
                    onAction="#handleStatistics"/>

            <VBox
                    VBox.vgrow="ALWAYS"/>

            <Button
                    text="⚙  Settings"
                    maxWidth="Infinity"
                    styleClass="sidebar-button,
                                 sidebar-button-active"/>

        </VBox>

    </left>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <center>

        <VBox
                spacing="25"
                styleClass="settings-content">

            <padding>
                <Insets
                        top="40"
                        right="50"
                        bottom="40"
                        left="50"/>
            </padding>


            <!-- HEADER -->

            <VBox spacing="6">

                <Label
                        text="Settings"
                        styleClass="settings-title"/>

                <Label
                        text="Manage your Echoes profile and account."
                        styleClass="settings-subtitle"/>

            </VBox>


            <!-- =========================
                 PROFILE
                 ========================= -->

            <VBox
                    spacing="18"
                    styleClass="settings-card">

                <Label
                        text="👤 Profile"
                        styleClass="settings-section-title"/>

                <VBox spacing="7">

                    <Label
                            text="Name"
                            styleClass="settings-label"/>

                    <TextField
                            fx:id="nameField"
                            promptText="Your name"
                            styleClass="settings-field"/>

                </VBox>


                <VBox spacing="7">

                    <Label
                            text="Email"
                            styleClass="settings-label"/>

                    <TextField
                            fx:id="emailField"
                            promptText="Your email"
                            styleClass="settings-field"/>

                </VBox>


                <HBox
                        spacing="12">

                    <Button
                            text="Save Changes"
                            styleClass="settings-save-button"
                            onAction="#handleSave"/>

                    <Label
                            fx:id="statusLabel"
                            styleClass="settings-status"/>

                </HBox>

            </VBox>
            <!-- =========================
              APPEARANCE
     ========================= -->

            <VBox
                    spacing="15"
                    styleClass="settings-card">

                <Label
                        text="🎨 Appearance"
                        styleClass="settings-section-title"/>

                <Label
                        text="Choose how Echoes looks."
                        wrapText="true"
                        styleClass="settings-description"/>

                <HBox
                        spacing="15"
                        alignment="CENTER_LEFT">

                    <Label
                            text="Theme"
                            styleClass="settings-label"/>

                    <ComboBox
                            fx:id="themeBox"
                            prefWidth="220"
                            promptText="Select theme"
                            styleClass="theme-box"/>

                </HBox>

            </VBox>


            <!-- =========================
                 ACCOUNT
                 ========================= -->

            <VBox
                    spacing="15"
                    styleClass="settings-card">

                <Label
                        text="🔐 Account"
                        styleClass="settings-section-title"/>

                <Label
                        text="Sign out of your Echoes account on this device."
                        wrapText="true"
                        styleClass="settings-description"/>

                <Button
                        text="Logout"
                        styleClass="settings-logout-button"
                        onAction="#handleLogout"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>